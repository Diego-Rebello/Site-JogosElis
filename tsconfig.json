{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "vite-env.d.ts",
    "Games/*/*.ts",
    "Games/*/*.tsx",
    "Games/*/components",
    "Games/*/lib",
    "shared/*.d.ts",
    "tests"
  ]
}
